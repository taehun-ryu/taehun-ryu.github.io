---
import type { CollectionEntry } from 'astro:content';

interface Props {
  publication: CollectionEntry<'publications'>;
}

const { publication } = Astro.props;
const { data } = publication;
---

<article class="publication-row">
  <div class="publication-image">
    <img src={data.thumbnail} alt={data.thumbnailAlt} loading="lazy" />
  </div>
  <div class="publication-copy">
    <div class="publication-heading">
      <h3>{data.title}</h3>
      {data.badge && <span class="badge">{data.badge}</span>}
    </div>
    <p class="authors">
      {data.authors.map((author, index) => (
        <><span class:list={{ 'author-me': author === 'Taehun Ryu' }}>{author}</span>{index < data.authors.length - 1 ? ', ' : ''}</>
      ))}
    </p>
    <p class="venue"><span>{data.venueShort}</span> · {data.venue}</p>
    <div class="publication-links">
      {data.links.map((link) => <a href={link.url}>{link.label}</a>)}
    </div>
  </div>
</article>
