---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const href = `/projects/${project.id}/`;
---

<a class="project-card" href={href} target="_blank" rel="noopener noreferrer" aria-label={`${project.data.title}, opens in a new tab`}>
  <div class="project-image">
    <img src={project.data.image} alt={project.data.imageAlt} loading="lazy" />
  </div>
  <div class="project-copy">
    <p class="project-meta">{project.data.affiliation}</p>
    <h3>{project.data.title} <span aria-hidden="true">↗</span></h3>
    <p>{project.data.summary}</p>
  </div>
</a>
