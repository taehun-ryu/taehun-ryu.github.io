---
const awards = [
  { year: '2024', title: 'Encouragement Award', event: 'Intelligent Robotics Consortium Creative Capstone Design Competition', scope: 'National competition', project: 'Table Robot System', href: '/projects/table-robot/' },
  { year: '2024', title: 'Grand Prize', event: 'Creative Capstone Design Competition', scope: 'Hanyang University ERICA, College of Engineering', progression: { level: 'college', next: 'national competition' }, project: 'Table Robot System', href: '/projects/table-robot/' },
  { year: '2024', title: 'Gold Award', event: 'Capstone Design Fair', scope: 'Hanyang University ERICA, Department of Robotics', progression: { level: 'department', next: 'college competition' }, project: 'Table Robot System', href: '/projects/table-robot/' },
  { year: '2024', title: 'Undergraduate Student Paper Award', event: 'Undergraduate Student Paper Competition', scope: 'Institute of Control, Robotics, and Systems', project: '', href: '', paper: '/uploads/icros2024.pdf' },
  { year: '2023', title: 'Encouragement Award', event: 'Digital Innovation Sharing University Robot Building Competition', scope: '', project: 'Large Unmanned Store System', href: '/projects/unmanned-store/' },
];
const scholarships = [
  { period: 'Spring 2024', title: 'Hanyang University ERICA Academic Excellence Scholarship', institution: 'Hanyang University ERICA', detail: 'Selected as the sole recipient among all first- through fourth-year students in the Department of Robotics.' },
  { period: 'Fall 2023', title: 'National Excellence Scholarship (Science and Engineering)', institution: 'Korea Student Aid Foundation', detail: '' },
  { period: '2022–2023', title: 'Merit-Based Scholarships', institution: 'Hanyang University ERICA', detail: '', grants: [
    { period: 'Fall 2023', title: 'Special Academic Merit Scholarship (성적우수 특별장학)' },
    { period: 'Fall 2022', title: 'SHARE Academic Merit Scholarship I (SHARE 성적우수장학Ⅰ)' },
    { period: 'Fall 2022', title: 'Special Academic Merit Scholarship (성적우수 특별장학)' },
  ] },
];
---

<section class="background-subsection honors-subsection" id="honors" aria-labelledby="awards-title">
  <h3 id="awards-title">Awards</h3>
  <div class="honors-list">
    {awards.map((award) => (
      <div class="honors-row">
        <p class="honors-period">{award.year}</p>
        <div>
          <h4>{award.title}</h4>
          <p>{award.event}{award.scope && <> · {award.scope === 'National competition' ? <strong>{award.scope}</strong> : award.scope}</>}</p>
          {award.progression && <p><strong>1st place</strong> at the {award.progression.level} level; advanced to the {award.progression.next}.</p>}
          {award.project && <a class="honors-project" href={award.href}>{award.project}</a>}
          {award.paper && <>{award.project && <span aria-hidden="true"> · </span>}<a class="honors-project" href={award.paper}>Paper</a></>}
        </div>
      </div>
    ))}
  </div>
</section>

<section class="background-subsection honors-subsection" aria-labelledby="scholarships-title">
  <h3 id="scholarships-title">Scholarships</h3>
  <div class="honors-list">
    {scholarships.map((scholarship) => (
      <div class="honors-row">
        <p class="honors-period">{scholarship.period}</p>
        <div>
          <h4>{scholarship.title}</h4>
          <p>{scholarship.institution}</p>
          {scholarship.detail && <p>{scholarship.detail}</p>}
          {scholarship.grants && (
            <ul class="honors-grants">
              {scholarship.grants.map((grant) => (
                <li><span>{grant.period}</span><span>{grant.title}</span></li>
              ))}
            </ul>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
